{
  "name": "typescript",
  "core": ">=9.0,<10",
  "order": 10,
  "family": "typescript",
  "backends": {
    "typescript": {
      "label": "TypeScript \u2014 Node and npm workspaces, ESLint, `tsc`, Vitest",
      "targets": [
        "none",
        "existing",
        "aws",
        "azure"
      ],
      "options": {
        "http": [
          "none",
          "fastify"
        ],
        "auth": [
          "none",
          "keycloak",
          "cognito",
          "entra",
          "auth0"
        ],
        "users": [
          "none",
          "keycloak",
          "cognito",
          "auth0"
        ],
        "persistence": [
          "memory",
          "sqlite",
          "postgres"
        ],
        "write-model": [
          "events",
          "state"
        ]
      },
      "defaults": {
        "http": "fastify"
      }
    }
  },
  "axes": {
    "http": {
      "fastify": {
        "label": "Fastify \u2014 JSON API, schema-parsed at the edge",
        "capabilities": [
          "http-fastify"
        ],
        "features": [
          "fastify"
        ],
        "containers": [],
        "migrations": false,
        "integration-suite": false,
        "targets": [
          "none",
          "existing",
          "aws",
          "azure"
        ],
        "app-in-compose": true,
        "repository-owned": [
          "packages/api-client"
        ],
        "web-app-owned": [
          "src/routes",
          "tests/routes"
        ]
      }
    }
  }
}
